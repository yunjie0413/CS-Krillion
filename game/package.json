{
  "name": "cs-krillion-game",
  "private": true,
  "type": "module",
  "scripts": {
    "pack": "node scripts/build-pack.mjs",
    "schedule": "node scripts/schedule.mjs",
    "build": "node scripts/build-web.mjs",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "dev": "npm run build && wrangler dev",
    "db:local": "wrangler d1 execute cs-krillion --local --file schema.sql",
    "deploy": "npm run build && wrangler deploy"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20261120.1",
    "esbuild": "^0.28.2",
    "typescript": "^7.0.2",
    "vitest": "^5.1.1",
    "wrangler": "^4.166.0"
  }
}
